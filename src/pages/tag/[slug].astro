---
import { decodeSlug, getEntriesByTerm, getTerm, getTermsForEntries } from "emdash";
import NewsletterLayout from "../../layouts/NewsletterLayout.astro";
import IssueRow from "../../components/IssueRow.astro";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");
const [term, posts] = await Promise.all([
  getTerm("tag", slug),
  getEntriesByTerm("posts", "tag", slug)
]);
if (!term) return Astro.redirect("/404");
const sorted = [...posts].sort((a: any, b: any) => Number(b.data.publishedAt || 0) - Number(a.data.publishedAt || 0));
const tagsByEntry = await getTermsForEntries("posts", sorted.map((entry: any) => entry.data.id), "tag");
---

<NewsletterLayout title={`Tag: ${term.label}`} description={`Issues tagged ${term.label}`}>
  <header class="newsletter-taxonomy-header">
    <h1>{term.label}</h1>
    <p>{sorted.length} issue{sorted.length === 1 ? "" : "s"}</p>
  </header>
  <div class="newsletter-divider"></div>
  <section class="newsletter-list">
    {sorted.map((issue: any) => <IssueRow issue={issue} tags={tagsByEntry.get(issue.data.id) || []} />)}
  </section>
</NewsletterLayout>
