{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Sylee Newsletter",
    "description": "A monochrome, issue-driven newsletter theme inspired by sylee.dev/newsletter.",
    "author": "Shih-Yung Lee"
  },
  "settings": {
    "title": "Newsletter Notes",
    "tagline": "An independent newsletter about technology, craft, and the web.",
    "postsPerPage": 7,
    "dateFormat": "MMM d, yyyy"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Issues",
      "labelSingular": "Issue",
      "description": "Newsletter issues rendered at /newsletter/[slug].",
      "icon": "newspaper",
      "supports": ["drafts", "revisions", "search"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "featured_image", "label": "Featured Image", "type": "image" },
        { "slug": "content", "label": "Content", "type": "portableText" },
        { "slug": "excerpt", "label": "Excerpt", "type": "text" }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "description": "Standalone pages.",
      "icon": "file-text",
      "supports": ["drafts", "revisions", "search"],
      "fields": [
        { "slug": "title", "label": "Title", "type": "string", "required": true },
        { "slug": "content", "label": "Content", "type": "portableText" }
      ]
    }
  ],
  "taxonomies": [
    {
      "name": "category",
      "label": "Categories",
      "labelSingular": "Category",
      "hierarchical": true,
      "collections": ["posts"],
      "terms": [
        { "slug": "newsletter", "label": "Newsletter" }
      ]
    },
    {
      "name": "tag",
      "label": "Tags",
      "labelSingular": "Tag",
      "hierarchical": false,
      "collections": ["posts"],
      "terms": [
        { "slug": "newsletter", "label": "Newsletter" },
        { "slug": "cloudflare", "label": "Cloudflare" },
        { "slug": "open-source", "label": "Open Source" },
        { "slug": "ai", "label": "AI" }
      ]
    }
  ],
  "bylines": [
    {
      "id": "author",
      "slug": "author",
      "displayName": "Author",
      "bio": "Newsletter author"
    }
  ],
  "menus": [
    {
      "name": "primary",
      "label": "Primary Navigation",
      "items": [
        { "type": "custom", "label": "Issues", "url": "/newsletter" },
        { "type": "custom", "label": "Search", "url": "/search" },
        { "type": "custom", "label": "RSS", "url": "/rss.xml" }
      ]
    }
  ],
  "content": {
    "pages": [
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "About",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This theme is built for issue-driven writing: a big monochrome masthead, date-first archive rows, and clean long-form reading pages." }
              ]
            }
          ]
        }
      }
    ],
    "posts": [
      {
        "id": "issue-003",
        "slug": "issue-003",
        "status": "published",
        "data": {
          "title": "Designing a Durable Newsletter Template - #3",
          "excerpt": "A sample issue that demonstrates the large masthead, bold dividers, and long-form reading rhythm of this theme.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "This is fictional sample content included only to show how the newsletter layout behaves after a fresh EmDash seed import." }
              ]
            },
            {
              "_type": "block",
              "style": "h2",
              "children": [
                { "_type": "span", "text": "A strong issue-driven archive" }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Each issue can include essays, links, notes, code snippets, and embedded media while keeping the page focused and readable." }
              ]
            },
            {
              "_type": "embed",
              "_key": "sample-youtube",
              "url": "https://www.youtube.com/watch?v=jNQXAC9IVRw",
              "provider": "youtube",
              "caption": "Sample YouTube embed"
            }
          ]
        },
        "bylines": [{ "byline": "author" }],
        "taxonomies": {
          "category": ["newsletter"],
          "tag": ["newsletter", "open-source"]
        }
      },
      {
        "id": "issue-002",
        "slug": "issue-002",
        "status": "published",
        "data": {
          "title": "Notes from the Open Web - #2",
          "excerpt": "A fictional issue for testing archive rows, tag pills, and social embed blocks without shipping personal blog content.",
          "content": [
            {
              "_type": "block",
              "style": "h2",
              "children": [
                { "_type": "span", "text": "Portable Text blocks" }
              ]
            },
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "The theme supports standard EmDash rich text blocks plus plugin-provided social embeds for services such as X/Twitter and Bluesky." }
              ]
            },
            {
              "_type": "socialEmbed",
              "_key": "sample-twitter",
              "platform": "twitter",
              "url": "https://x.com/example/status/1234567890",
              "title": "Example social post"
            }
          ]
        },
        "bylines": [{ "byline": "author" }],
        "taxonomies": {
          "category": ["newsletter"],
          "tag": ["newsletter", "cloudflare"]
        }
      },
      {
        "id": "issue-001",
        "slug": "issue-001",
        "status": "published",
        "data": {
          "title": "Starting the Newsletter - #1",
          "excerpt": "A neutral starter issue that shows how a freshly seeded site looks before authors replace the demo content.",
          "content": [
            {
              "_type": "block",
              "style": "normal",
              "children": [
                { "_type": "span", "text": "Replace this fictional starter issue with your own first newsletter entry after installing the theme." }
              ]
            }
          ]
        },
        "bylines": [{ "byline": "author" }],
        "taxonomies": {
          "category": ["newsletter"],
          "tag": ["newsletter", "ai"]
        }
      }
    ]
  }
}
